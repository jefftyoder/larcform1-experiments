+# Exchange-space (PointSpace) fields and their broadcasts also hold one value.
+# On a CUDA device `parent(f)` is a CuArray and `first` is a scalar index, which
+# CUDA.jl disallows by default — so route the read through ClimaComms.allowscalar,
+# which is a plain call (no wrapper, no cost) on any CPU device. The ice model
+# itself stays on the host: it is a single point, so only scalars cross the
+# device boundary and there is nothing to gain from putting it on the GPU.
+_point(f::CC.Fields.Field) =
+    ClimaComms.allowscalar(first, ClimaComms.device(f), parent(f))
 
 _T_sfc_K(sim) = _point(_top_thermodynamics(sim.model).top_surface_temperature) + sim.params.C_to_K
 
